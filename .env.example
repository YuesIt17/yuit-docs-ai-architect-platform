# RetailPartnerX Knowledge Platform
APP_ENV=development
LOG_LEVEL=INFO
# Demo Bearer tokens only — NOT production IdP. Set false to refuse protected ops.
DEMO_AUTH_ENABLED=true
JWT_SECRET=dev-retailpartnerx-change-me
INDEX_VERSION=v1
POLICY_VERSION=v1
PROMPT_VERSION=v1

# LLM: MOCK | OLLAMA | VLLM (runtime URL changes allowlisted; compliance_officer only)
LLM_PROVIDER=MOCK
# Desktop K8s API → Compose Ollama on host:
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=not-needed
LLM_MODEL=qwen2.5:0.5b
# API on host: OPENAI_BASE_URL=http://localhost:11434/v1
# Submission vLLM profile: LLM_PROVIDER=VLLM OPENAI_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ
LLM_ALLOW_RUNTIME_URL_OVERRIDE=false
LLM_ALLOWED_BASE_URLS=http://127.0.0.1:11434/v1,http://localhost:11434/v1,http://host.docker.internal:11434/v1,http://127.0.0.1:8000/v1,http://localhost:8000/v1,http://vllm:8000/v1,http://host.docker.internal:8000/v1

# Feature flags (semantic cache off by default until re-auth on hit is trusted)
ENABLE_SEMANTIC_CACHE=false
ENABLE_VLM=false
ENABLE_VISION_OCR=true

# Data plane
# Compose: memory (no MinIO). K8s Helm: live + minio:9000 in-cluster.
STORE_BACKEND=memory
STORE_STRICT_LIVE=true
ENABLE_GRAPH_RESOLVE=true
RETRIEVAL_REFINE_MAX=1
POSTGRES_DSN=postgresql+asyncpg://kp:kp@localhost:5432/knowledge
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=retailpartnerx
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
# MinIO only when STORE_BACKEND=live (K8s); Compose does not run MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-platform
MINIO_SECURE=false

# Observability (OTLP → Compose Tempo; metrics → Prometheus; JSON logs → Loki via Alloy)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=kp-api
PROMETHEUS_ENABLED=true

# Embeddings (local sentence-transformers or mock)
EMBEDDING_PROVIDER=MOCK
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# EMBEDDING_LOCAL_PATH=./models/multilingual-e5-small