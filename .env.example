# RetailPartnerX Knowledge Platform
APP_ENV=development
LOG_LEVEL=INFO
JWT_SECRET=dev-retailpartnerx-change-me
INDEX_VERSION=v1
POLICY_VERSION=v1

# LLM: MOCK | VLLM | OLLAMA (also switchable at runtime via UI /v1/llm/config)
LLM_PROVIDER=MOCK
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=not-needed
LLM_MODEL=qwen2.5:7b-instruct
# Compose network presets:
#   OLLAMA: OPENAI_BASE_URL=http://ollama:11434/v1
#   VLLM:   OPENAI_BASE_URL=http://vllm:8000/v1  LLM_MODEL=Qwen/Qwen2.5-7B-Instruct


# Feature flags
ENABLE_SEMANTIC_CACHE=true
ENABLE_VLM=false
ENABLE_VISION_OCR=true

# Data plane
POSTGRES_DSN=postgresql+asyncpg://kp:kp@localhost:5432/knowledge
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=retailpartnerx
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-platform
MINIO_SECURE=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=kp-api
PROMETHEUS_ENABLED=true

# Embeddings (local sentence-transformers or mock)
EMBEDDING_PROVIDER=MOCK
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=384